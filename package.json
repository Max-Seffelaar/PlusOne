{
  "name": "plusone-guestlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/setup-git-hooks.mjs",
    "dev": "node scripts/dev-env.mjs --serve",
    "dev:env": "node scripts/dev-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test tests/e2e/core-flow.spec.ts tests/e2e/app-home-events-visible.spec.ts tests/e2e/api-health.spec.ts",
    "e2e:ui": "playwright test --ui",
    "db:reset": "supabase db reset",
    "db:fresh": "supabase db reset && node scripts/dev-mfa.mjs",
    "db:test": "supabase test db",
    "db:test:concurrency": "node scripts/quota-trigger-concurrency-test.mjs",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:gen": "supabase gen types --local --lang=typescript --schema public > src/lib/database.types.ts",
    "supabase:gen:offline": "node scripts/gen-types.mjs",
    "dev:mfa": "node scripts/dev-mfa.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.0",
    "@tanstack/react-query": "^5.56.0",
    "@tanstack/react-query-persist-client": "^5.56.0",
    "@tanstack/react-virtual": "^3.14.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "next": "^15.0.0",
    "next-pwa": "^5.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-phone-number-input": "^3.4.17",
    "recharts": "^3.8.1",
    "stripe": "^18",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@shadcn/ui": "latest",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.0",
    "pg": "^8.22.0",
    "playwright": "^1.45.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^8.0.16",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.0.0"
}
