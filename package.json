{
  "name": "plusone-guestlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/setup-git-hooks.mjs",
    "dev": "node scripts/dev-env.mjs --serve",
    "dev:env": "node scripts/dev-env.mjs",
    "dev:fake": "node scripts/dev/fake-supabase.mjs --serve",
    "shot": "node scripts/dev/screenshot.mjs",
    "clean:next": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true }); console.log('.next removed')\"",
    "build": "node scripts/hooks/check-required-env.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test tests/e2e/core-flow.spec.ts tests/e2e/app-home-events-visible.spec.ts tests/e2e/app-shell-no-remount.spec.ts tests/e2e/api-health.spec.ts tests/e2e/door-offline-reload.spec.ts tests/e2e/native-shell-guard.spec.ts",
    "e2e:layout": "playwright test -c playwright.layout.config.ts",
    "qa:flows": "node scripts/flow-shots/run.mjs",
    "promo:seed": "node scripts/promo-seed.mjs",
    "store:screenshots": "node scripts/store-screenshot-seed.mjs && playwright test -c playwright.store.config.ts",
    "e2e:ui": "playwright test --ui",
    "db:reset": "supabase db reset",
    "db:fresh": "supabase db reset && node scripts/dev-mfa.mjs",
    "db:test": "node scripts/db-test.mjs",
    "db:test:concurrency": "node scripts/quota-trigger-concurrency-test.mjs && node scripts/last-admin-concurrency-test.mjs",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:gen": "supabase gen types --local --lang=typescript --schema public > src/lib/database.types.ts",
    "supabase:gen:offline": "node scripts/gen-types.mjs",
    "dev:mfa": "node scripts/dev-mfa.mjs",
    "stack": "node scripts/session-setup.mjs stack",
    "capacitor:copy:after": "node scripts/native/offline-origin.mjs",
    "billing-mails:local": "node scripts/billing-mails-local.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@sentry/nextjs": "^10.76.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.15",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "next": "^15.5.27",
    "next-pwa": "^5.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-phone-number-input": "^3.4.18",
    "stripe": "^18",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.0",
    "@shadcn/ui": "latest",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.27",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "require-in-the-middle": "^8.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^8.3.4",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.0.0"
}
