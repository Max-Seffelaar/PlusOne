{
  "root": true,
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "react-hooks/exhaustive-deps": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-empty-object-type": "off"
  },
  "overrides": [
    {
      "files": [
        "src/components/po/screens/**/*.tsx"
      ],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 850,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/components/po/app.tsx",
        "src/components/po/app-chrome.tsx",
        "src/components/po/app-screens.tsx",
        "src/components/po/door-branch.tsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 800
          }
        ]
      }
    }
  ]
}
