{
  "root": true,
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "react-hooks/exhaustive-deps": "warn",
    "@typescript-eslint/no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_"
    }],
    "@typescript-eslint/no-empty-object-type": "off"
  },
  "overrides": [
    {
      "files": ["src/components/po/screens/**/*.tsx"],
      "rules": {
        "max-lines": ["warn", { "max": 850, "skipBlankLines": true, "skipComments": true }]
      }
    }
  ]
}
