# Supabase — the app reads the PLAIN names (CLAUDE.md §Env: no staging DB).
# Local dev: `pnpm dev` auto-writes .env.local from the running local stack.
NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-or-publishable-key]
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]   # server-only, never NEXT_PUBLIC

# Stripe Billing (fase 13, #32) — all server-only. Absent = billing disabled:
# the app runs keyless on the stub provider (trial/comped venues keep working).
STRIPE_SECRET_KEY=[stripe-secret-key]
STRIPE_WEBHOOK_SECRET=[stripe-webhook-signing-secret]
# No price ids: the app finds the Pro prices in Stripe by lookup key
# (pro_monthly / pro_yearly, set on the prices in the dashboard).
# Manual 21% NL BTW tax rate applied to every subscription (exclusive).
STRIPE_TAX_RATE_ID=[txr_...]
# NOTE: no publishable key needed — checkout + portal are Stripe-hosted
# redirects; the app never loads Stripe.js client-side.

# Resend app mail (Mail-infra F0, z8uq9m2yvt) — both server-only, Vercel
# Production only; never NEXT_PUBLIC. This is a SECOND Resend key (permission
# "Sending access", domain plus-one.io), separate from the SMTP key that lives
# only in Supabase Auth (docs/mail-deliverability.md "Secret handling").
# Absent key = stub provider: locally the team mail is logged without the
# address; a production build keeps the old magic-link login mail.
RESEND_API_KEY=
# Signing secret (whsec_...) of the webhook endpoint
# https://app.plus-one.io/api/webhooks/resend. Absent = the route refuses every
# delivery (503) and processes nothing.
RESEND_WEBHOOK_SECRET=
# Guest mail (Gastcommunicatie F, z8uq9m2vpy): "Send reminder" on an event,
# platform admins only, a test feature. Off unless exactly "true".
GUEST_REMINDER_ENABLED=

# Platform digest Edge Function (z8uq9m2ybj). NOT Vercel env: these are Supabase
# Edge Function secrets (`supabase secrets set`), read only by
# supabase/functions/platform-digest. RESEND_API_KEY there = the same app-mail
# key as above. APP_URL = app origin for the Overview link (absent = no link).
# PLATFORM_DIGEST_MAIL_CATCHER_URL = local stack only (Mailpit inside Docker,
# e.g. http://supabase_inbucket_PlusOne_Guestlist:8025); ignored unless the
# function's SUPABASE_URL is local. Runbook: docs/mail-deliverability.md.
# APP_URL=
# PLATFORM_DIGEST_MAIL_CATCHER_URL=

# Google Places API (New) for address autocomplete (Onboarding A, z8uq9m2vg5).
# Server-only, never NEXT_PUBLIC: the browser talks to our /api/places proxy.
# Restrict the key to "Places API (New)" in Google Cloud (no referrer
# restriction: the calls come from the server) and set a budget alert.
# Absent = the address fields stay plain text fields.
GOOGLE_PLACES_API_KEY=

# Local Supabase (for development)
SUPABASE_DB_PASSWORD=[local-db-password]
SUPABASE_JWT_SECRET=[local-jwt-secret]

# App configuration
NEXT_PUBLIC_APP_NAME=PLUSONE
# The app lives on app.plus-one.io; the marketing site (repo Plus-One.io) owns plus-one.io.
NEXT_PUBLIC_APP_URL=https://app.plus-one.io

# Landing IP hash salt (server-only). REQUIRED in production: the public request
# flow salts + sha256's client IPs before storing them for throttling, so the
# stored hashes are never reversible. Without this set, prod FAILS CLOSED (the
# landing page throws) rather than fall back to the committed dev salt (C5).
# Generate a long random value, e.g. `openssl rand -hex 32`.
LANDING_IP_SALT=[random-hex-32]

# Public-RPC trust secret (server-only, 20261006170000). Sent as the
# x-plusone-throttle-trust header on the anon throttled RPCs so the DB honours
# the IP hash above only from this server, not from raw PostgREST callers.
# REQUIRED for a production build. The DB stores only its sha256 in
# public_throttle_trusted_callers; leave it empty locally (no row = no check).
# Generate with `openssl rand -hex 32`; runbook: docs/landing-rate-limit-hardening.md §5.
PUBLIC_RPC_TRUST_SECRET=

# Store-review login (/auth/review-login, 86ey6bfug; runbook docs/review-login.md).
# Server-only. Leave both EMPTY: the route 404s unless the code has >= 26
# letters/digits AND the expiry is an ISO timestamp with a zone, in the future
# and at most 60 days out. After the expiry the route closes by itself and every
# demo-account session ends. New code + expiry per submission. Needs
# LANDING_IP_SALT (above) in prod.
REVIEW_LOGIN_CODE=
REVIEW_LOGIN_EXPIRES_AT=

# Android App Links (Fase 17 S4; docs/native/android-release.md step 10). Server-only.
# SHA-256 certificate fingerprints from Play Console → App signing, comma-separated:
# the Play App Signing key (+ the upload key for sideloaded builds). Each is 32
# colon-separated hex bytes (AA:BB:…). Empty/unset or ANY malformed entry =
# /.well-known/assetlinks.json answers 404 (never an empty/wildcard statement).
ANDROID_APP_LINK_SHA256=

# Vercel analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=[vercel-analytics-id]

# Cloudflare Turnstile on the public landing form (86ey2czr6, rate-limit
# hardening, before the first real public event). Absent = keyless: the
# widget never renders and the server passes verification open — same stance
# as Stripe. Site key is public (bundled client-side); secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=[turnstile-site-key]
TURNSTILE_SECRET_KEY=[turnstile-secret-key]

# Sentry (error monitoring, EU region — de.sentry.io)
# DSN is public (bundled client-side). Leave empty locally: SDK stays disabled.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source-map upload. Vercel-only via the Sentry marketplace
# integration. NEVER commit a real token, NEVER prefix with NEXT_PUBLIC_.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
