# Supabase — Multi-tenant auth, database, realtime, edge functions
# Project region: eu-central-1 (Frankfurt). Find these on supabase.io → Project Settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only; never expose in the client. Service role bypasses RLS for trusted server-side operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Stripe — Billing (optional for MVP, required for production). See CLAUDE.md decision #32.
# Keys from stripe.com → Dashboard → Developers → API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Node environment
NODE_ENV=development
