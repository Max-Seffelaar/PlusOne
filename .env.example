# Supabase Staging (development)
NEXT_PUBLIC_SUPABASE_URL_STAGING=https://[project-id]-staging.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_STAGING=[anon-key-staging]
SUPABASE_SERVICE_ROLE_KEY_STAGING=[service-key-staging]

# Supabase Production
NEXT_PUBLIC_SUPABASE_URL_PROD=https://[project-id]-prod.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=[anon-key-prod]
SUPABASE_SERVICE_ROLE_KEY_PROD=[service-key-prod]

# Environment selection (staging or production)
NEXT_PUBLIC_ENV=staging

# Stripe (phase 13, optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=[stripe-publishable-key]
STRIPE_SECRET_KEY=[stripe-secret-key]
STRIPE_WEBHOOK_SECRET=[stripe-webhook-secret]

# Local Supabase (for development)
SUPABASE_DB_PASSWORD=[local-db-password]
SUPABASE_JWT_SECRET=[local-jwt-secret]

# App configuration
NEXT_PUBLIC_APP_NAME=PLUSONE
NEXT_PUBLIC_APP_URL=https://[your-domain]

# Vercel analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=[vercel-analytics-id]
