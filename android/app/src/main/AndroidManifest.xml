<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (Fase 17 S4, plan decision 11): ONLY the two auth
                 handlers, exact paths. Never /e/* (guest landing stays in the
                 browser). Verified against https://app.plus-one.io/.well-known/assetlinks.json;
                 host + paths are pinned to src/lib/native/app-links.ts by
                 tests/unit/app-links.test.ts. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="app.plus-one.io" />
                <data android:path="/auth/confirm" />
                <data android:path="/auth/callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Push (Fase 17 N5): what the system uses for an FCM notification that
             arrives while the app is in the background. The channel itself is
             created by the web app (capacitor-provider.ts) before registering. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_plusone" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/plusone_push_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/plusone_push_channel_id" />
        <!-- Consent-first push (86exxuvye): no FCM token / Firebase installation ID
             on cold start before the person opts in. The opt-in path still yields a
             token: @capacitor/push-notifications' register() calls
             setAutoInitEnabled(true) before getToken(), and its unregister() (Profile
             "off", sign-out) sets it back to false and deletes the token. Firebase
             persists the runtime value across restarts. No analytics flag: Firebase
             Analytics is not on the classpath (only firebase-messaging). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- N7: without it Android WebView's network-change notifier is off, so
         navigator.onLine stays true and the `online`/`offline` events never
         fire — the door outbox would only drain on its 60 s safety sync and the
         offline page would only recover on its poll. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+: runtime permission for push (asked in-app, never at launch). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
