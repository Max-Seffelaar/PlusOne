<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. The webview's storage holds the auth
  session cookie and the door's IndexedDB snapshot (guest PII). CLAUDE.md's
  device-storage rule keeps that session-scoped, so nothing is backed up to the
  cloud or copied to a new device; a new device logs in fresh.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
